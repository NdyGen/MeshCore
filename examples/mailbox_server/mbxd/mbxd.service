# Holds the serial port of the mailbox radio (examples/mailbox_server) and keeps the deposited DMs in SQLite.
# Install: see README.md next to this file. Adjust the --port path to your radio.
[Unit]
Description=MeshCore DM mailbox daemon (mbxd)

[Service]
ExecStart=/usr/bin/python3 /opt/mbxd/mbxd.py --db /var/lib/mbxd/mbxd.db serve --port /dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
User=mbxd
Group=mbxd
SupplementaryGroups=dialout
StateDirectory=mbxd
StateDirectoryMode=0700
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
